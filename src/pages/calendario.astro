---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventItem from '../components/EventItem.astro';
import EmptyState from '../components/EmptyState.astro';
import { events } from '../data/events';
---

<BaseLayout title="Calendário" description="Calendário de provas, treinos e assembleias do CORK.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Agenda</p>
      <h1>Calendário de provas e eventos</h1>
      <p class="intro">
        Provas, assembleias e outros eventos do clube. Para integrar com o seu
        telemóvel ou agenda, este calendário pode também ser publicado como
        feed iCal ou embutido a partir do Google Calendar.
      </p>
      {events.length === 0 ? (
        <EmptyState />
      ) : (
        <div class="events-list">
          {events.map((e) => <EventItem {...e} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  h1 { margin-bottom: 0.5rem; }
  .intro {
    max-width: 640px;
    margin-bottom: 2rem;
  }
  .events-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
</style>
