---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import EventItem from '../components/EventItem.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import type { Slide } from '../components/HeroCarousel.astro';
import { getCollection } from 'astro:content';
import athleteActionPhoto from '../assets/members/709406104_18093211694193271_6887596880022177049_n.jpg';

const allNews = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestNews = allNews.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const upcomingEvents = [
  { date: '27 Set', title: 'Corta-Mato Distrital', location: 'Parque da Cidade, Évora', type: 'prova' as const },
  { date: '03 Out', title: 'Assembleia Geral Ordinária', location: 'Sede do clube, 19h00', type: 'reuniao' as const },
  { date: '11 Out', title: 'Meeting de Pista Coberta', location: 'Pavilhão Municipal', type: 'prova' as const },
];
const nextEvent = upcomingEvents[0];

const allResults = await getCollection('results');
const records = allResults.map((r) => ({
  athlete: r.data.athlete,
  event: r.data.event,
  result: r.data.result,
  competition: r.data.competition,
  dateLabel: r.data.date.toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' }),
}));
const firstRecord = records[0];

const carouselSlides: Slide[] = [
  {
    id: 'event',
    eyebrow: 'Próxima prova',
    title: nextEvent.title,
    description: `${nextEvent.date} · ${nextEvent.location}`,
    ctaLabel: 'Ver calendário completo',
    ctaHref: base + '/calendario',
    bgClass: 'bg-event',
  },
  {
    id: 'member',
    eyebrow: 'Junte-se a nós',
    title: 'Queres correr com o CORK?',
    description: 'Formação, treinos e competição para todas as idades. Torna-te sócio e faz parte do clube.',
    ctaLabel: 'Torna-te sócio',
    ctaHref: base + '/contactos',
    bgClass: 'bg-member',
  },
  {
    id: 'record',
    eyebrow: 'Recorde do clube',
    title: firstRecord ? `${firstRecord.athlete} — ${firstRecord.event}: ${firstRecord.result}` : 'Resultados do clube',
    description: firstRecord ? `${firstRecord.competition} · ${firstRecord.dateLabel}` : '',
    ctaLabel: 'Ver todos os resultados',
    ctaHref: base + '/resultados',
    image: athleteActionPhoto,
    imageAlt: 'Atleta do CORK em prova',
  },
];
---

<BaseLayout title="Início" description="CORK — Cortiçadas Clube Alentejo. Notícias, calendário, resultados e vida do clube.">
  <HeroCarousel slides={carouselSlides} records={records} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Últimas notícias</h2>
        <a href={base + '/noticias'}>Ver todas →</a>
      </div>
      <div class="news-grid">
        {latestNews.map((post) => (
          <NewsCard
            title={post.data.title}
            date={post.data.date}
            summary={post.data.summary}
            author={post.data.author}
            href={base + '/noticias/' + post.slug}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <h2>Próximos eventos</h2>
        <a href={base + '/calendario'}>Ver calendário completo →</a>
      </div>
      <div class="events-list">
        {upcomingEvents.map((e) => <EventItem {...e} />)}
      </div>
    </div>
  </section>

  <section class="section" id="newsletter">
    <div class="container newsletter-box card">
      <div>
        <h2>Não perca nenhuma novidade</h2>
        <p>Receba notícias, convocatórias e resultados diretamente no seu email.</p>
      </div>
      <form class="newsletter-form" action={base + '/newsletter'} method="get">
        <input type="email" name="email" placeholder="o.seu@email.com" required />
        <button class="btn" type="submit">Subscrever</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head a {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .newsletter-box {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    background: var(--color-bg-alt);
  }
  .newsletter-box h2 {
    font-size: 1.3rem;
  }
  .newsletter-box p {
    margin: 0;
  }
  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }
  .newsletter-form input {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.92rem;
    min-width: 220px;
  }
</style>
