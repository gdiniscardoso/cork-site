---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Sugestão enviada" description="Obrigado pela sua sugestão ao CORK.">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Participe</p>
      <h1>Obrigado!</h1>
      <p>
        A sua sugestão foi enviada com sucesso. A direção do clube irá
        analisá-la e entrará em contacto, se necessário.
      </p>
      <a class="btn" href={base + '/'}>Voltar à página inicial</a>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 640px; }
  h1 { margin-bottom: 0.5rem; }
  p { margin-bottom: 1.5rem; }
</style>
