---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Subscrição confirmada" description="Obrigado por subscrever a newsletter do CORK.">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Newsletter</p>
      <h1>Obrigado!</h1>
      <p>
        A sua subscrição foi registada. Verifique o seu email para confirmar
        a inscrição e passe a receber as novidades do clube.
      </p>
      <a class="btn" href={base + '/'}>Voltar à página inicial</a>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 640px; }
  h1 { margin-bottom: 0.5rem; }
  p { margin-bottom: 1.5rem; }
</style>
