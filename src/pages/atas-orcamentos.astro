---
import BaseLayout from '../layouts/BaseLayout.astro';

// PoC data — in production these would be entries with links to PDF files
// (stored in /public/documentos/ or an external drive), added via the
// content workflow without touching this page's layout.
const documents = [
  { title: 'Ata da Assembleia Geral Ordinária', date: '15 Março 2026', type: 'Ata', href: '#' },
  { title: 'Orçamento aprovado — Época 2026/2027', date: '15 Março 2026', type: 'Orçamento', href: '#' },
  { title: 'Ata da Assembleia Geral Extraordinária', date: '02 Novembro 2025', type: 'Ata', href: '#' },
  { title: 'Relatório de Contas — Época 2025/2026', date: '20 Outubro 2025', type: 'Relatório', href: '#' },
  { title: 'Orçamento aprovado — Época 2025/2026', date: '18 Setembro 2025', type: 'Orçamento', href: '#' },
];
---

<BaseLayout title="Atas e Orçamentos" description="Atas de assembleia e orçamentos aprovados do CORK, para transparência institucional.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Transparência</p>
      <h1>Atas & Orçamentos</h1>
      <p class="intro">
        Documentos institucionais do clube, disponibilizados para consulta
        pelos sócios e pelo público em geral.
      </p>
      <div class="doc-list">
        {documents.map((doc) => (
          <a class="doc-item card" href={doc.href}>
            <span class="tag">{doc.type}</span>
            <div class="doc-body">
              <h3>{doc.title}</h3>
              <p>{doc.date}</p>
            </div>
            <span class="doc-action">Descarregar PDF →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { margin-bottom: 0.5rem; }
  .intro {
    max-width: 640px;
    margin-bottom: 2rem;
  }
  .doc-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .doc-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .doc-item:hover {
    border-color: var(--color-primary);
  }
  .doc-body {
    flex: 1;
  }
  .doc-body h3 {
    margin: 0 0 0.15rem;
    font-size: 1rem;
  }
  .doc-body p {
    margin: 0;
    font-size: 0.85rem;
  }
  .doc-action {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    flex-shrink: 0;
  }
</style>
