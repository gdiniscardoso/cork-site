---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const thanksUrl = new URL(base + '/obrigado-sugestoes/', Astro.site);
---

<BaseLayout title="Sugestões" description="Envie sugestões ao CORK.">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Participe</p>
      <h1>Sugestões</h1>
      <p>
        Tem uma ideia para melhorar o clube? Partilhe connosco.
      </p>
      <form class="form card" action="https://formspree.io/f/moevdqke" method="post">
        <input type="hidden" name="_subject" value="Nova sugestão — CORK" />
        <input type="hidden" name="_next" value={thanksUrl} />
        <label>
          Nome (opcional)
          <input type="text" name="name" />
        </label>
        <label>
          Email (opcional, para resposta)
          <input type="email" name="email" />
        </label>
        <label>
          Sugestão
          <textarea name="message" rows="5" required></textarea>
        </label>
        <p class="hint">
          Pode submeter esta sugestão de forma anónima — nome e email são
          opcionais. Se os indicar, consulte a nossa
          <a href={base + '/privacidade'}>Política de Privacidade</a> para
          saber como tratamos esses dados.
        </p>
        <button class="btn" type="submit">Enviar sugestão</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 640px; }
  h1 { margin-bottom: 0.5rem; }
  .form {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  input, textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    resize: vertical;
  }
  .hint {
    margin: -0.5rem 0 0;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--color-ink-soft);
  }
  button {
    align-self: flex-start;
  }
</style>
