---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CORK — Cortiçadas Clube Alentejo, clube de atletismo.' } = Astro.props;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self';
        script-src 'self' 'unsafe-inline' https://sibforms.com https://www.google.com https://www.gstatic.com;
        style-src 'self' 'unsafe-inline' https://sibforms.com;
        font-src 'self' https://assets.brevo.com;
        img-src 'self' data:;
        frame-src https://www.google.com;
        connect-src 'self' https://sibforms.com;
        form-action 'self' https://c8a90e9f.sibforms.com https://formspree.io;
        object-src 'none';
        base-uri 'self';"
    />
    <title>{title} · CORK</title>
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.png'} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
