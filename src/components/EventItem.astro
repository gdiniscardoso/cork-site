---
import { badgeStyle, badgeLabel, logoFor } from '../data/eventColors';

interface Props {
  date: string;
  endDate?: string;
  title: string;
  location: string;
  organizer?: string;
  discipline: string;
  scope?: string;
  source?: string;
  note?: string;
  isPast?: boolean;
}
const { date, endDate, title, location, organizer, discipline, scope, source, note, isPast } = Astro.props;

const parse = (s: string) => {
  const [y, m, d] = s.split('-').map(Number);
  return new Date(y, m - 1, d);
};
const sources = ['AAE', 'FPA'].filter((s) => source?.includes(s));
const start = parse(date);
const day = start.getDate();
const weekday = start.toLocaleDateString('pt-PT', { weekday: 'short' }).replace('.', '');

let rangeLabel = '';
if (endDate && endDate !== date) {
  const end = parse(endDate);
  const sameMonth = end.getMonth() === start.getMonth();
  rangeLabel = `até ${end.getDate()}${sameMonth ? '' : ' ' + end.toLocaleDateString('pt-PT', { month: 'short' })}`;
}
---

<article class:list={["event-item", "card", { past: isPast }]}>
  <div class="event-date">
    <div class="d">{day}</div>
    <div class="w">{weekday}</div>
  </div>
  <div class="event-body">
    <h4>{title}</h4>
    <div class="meta">
      <span>{location}</span>
      {organizer && <span>{organizer}</span>}
      {rangeLabel && <span>{rangeLabel}</span>}
    </div>
    <div class="tags">
      <span class="tag tag-colored" style={badgeStyle(discipline)}>{badgeLabel(discipline)}</span>
      {scope && <span class="tag tag-colored" style={badgeStyle(scope)}>{badgeLabel(scope)}</span>}
      {sources.map((s) => {
        const logo = logoFor(s);
        return logo
          ? <span class="src-icon" title={s}><img src={logo} alt={s} /></span>
          : <span class="tag tag-colored" style={badgeStyle(s)}>{s}</span>;
      })}
    </div>
    {note && <p class="note">{note}</p>}
  </div>
</article>

<style>
  .event-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem;
    align-items: start;
  }
  .event-item.past {
    opacity: 0.55;
  }
  .event-date {
    text-align: center;
    flex-shrink: 0;
  }
  .event-date .d {
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--color-primary);
    line-height: 1;
  }
  .event-date .w {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
  }
  .event-body h4 {
    margin: 0 0 0.2rem;
    font-size: 1rem;
  }
  .meta {
    color: var(--color-ink-soft);
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.75rem;
    margin-bottom: 0.4rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tag-colored {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(135deg, var(--g1), var(--g2));
  }
  /* AAE/FPA: round icon stretched to the badge row height */
  .src-icon {
    position: relative;
    align-self: center;
    flex: none;
    width: 1.5rem; /* = badge height */
    height: 1.5rem;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    border: 1px solid light-dark(var(--color-border), #5b6a61);
  }
  /* absolutely positioned so the image's intrinsic size never sets the row height */
  .src-icon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1px;
  }
  .note {
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    border-left: 2px solid var(--color-accent);
    padding-left: 0.6rem;
    margin: 0.5rem 0 0;
  }
</style>
