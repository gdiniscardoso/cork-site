---
interface Row {
  athlete: string;
  event: string;
  date: Date;
  competition: string;
  result: string;
  category?: string;
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
---

<div class="table-wrap card">
  <table>
    <thead>
      <tr>
        <th>Atleta</th>
        <th>Prova</th>
        <th>Resultado</th>
        <th>Competição</th>
        <th>Data</th>
        <th>Categoria</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td>{r.athlete}</td>
          <td>{r.event}</td>
          <td class="result">{r.result}</td>
          <td>{r.competition}</td>
          <td>{r.date.toLocaleDateString('pt-PT')}</td>
          <td>{r.category ?? '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    padding: 0;
    overflow-x: auto;
  }
  table {
    margin: 0;
  }
  th, td {
    padding: 0.75rem 1rem;
  }
  .result {
    font-weight: 700;
    color: var(--color-primary);
  }
</style>
