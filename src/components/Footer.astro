---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">CORK — Cortiçadas Clube Alentejo</p>
      <p class="footer-note">Clube de atletismo. Fundado a 10 Julho 2014.</p>
      <span class="footer-socials">
        <a href="https://www.instagram.com/cork_atletismo/" target="_blank" rel="noopener noreferrer" aria-label="Instagram do CORK">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com/corticadasccalentejo" target="_blank" rel="noopener noreferrer" aria-label="Facebook do CORK">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://wa.me/351936491700" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp do CORK">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </a>
      </span>
    </div>
    <div class="footer-links">
      <a href={base + '/atas-orcamentos'}>Atas & Orçamentos</a>
      <a href={base + '/reclamacoes'}>Reclamações</a>
      <a href={base + '/contactos'}>Contactos</a>
    </div>
    <div class="footer-newsletter">
      <p class="footer-note">Tem uma ideia ou sugestão?</p>
      <a class="btn btn-outline btn-sm" href={base + '/sugestoes'}>Enviar sugestão</a>
    </div>
    <div class="footer-newsletter">
      <p class="footer-note">Receba as novidades do clube:</p>
      <a class="btn btn-outline btn-sm" href={base + '/#newsletter'}>Subscrever newsletter</a>
    </div>
  </div>
  <div class="container">
    <p class="copyright">© {year} CORK. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    padding: 2.5rem 0 1rem;
    margin-top: 3rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-brand {
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.25rem;
  }

  .footer-socials {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .footer-socials a {
    display: inline-flex;
    color: var(--color-ink-soft);
  }

  .footer-socials a:hover {
    color: var(--color-primary);
  }

  .footer-note {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-links a {
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .btn-sm {
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
  }

  .copyright {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    padding-top: 1rem;
    margin: 0;
  }
</style>
