---
interface Props {
  title: string;
  date: Date;
  summary: string;
  href: string;
  author?: string;
}
const { title, date, summary, href, author } = Astro.props;
const formatted = date.toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="news-card card">
  <p class="news-date">{formatted}{author ? ` · ${author}` : ''}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="news-summary">{summary}</p>
  <a class="news-link" href={href}>Ler mais →</a>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .news-date {
    font-size: 0.78rem;
    color: var(--color-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0;
  }
  .news-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .news-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .news-card h3 a:hover {
    color: var(--color-primary);
  }
  .news-summary {
    margin: 0;
    font-size: 0.92rem;
  }
  .news-link {
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    margin-top: 0.25rem;
  }
</style>
